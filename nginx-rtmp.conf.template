# nginx-rtmp 配置 — 需要在构建时合并 modules-enabled
# Debian 的 libnginx-mod-rtmp 通过 modules-enabled/50-mod-rtmp.conf 加载模块

# 我们不能直接覆盖 nginx.conf，需要保留模块加载
# 改为使用 conf.d 方式：在 sites-available 放 rtmp 配置

worker_processes 1;

events {
    worker_connections 1024;
}

# 加载动态模块（Debian 模式）
include /etc/nginx/modules-enabled/*.conf;

# HTTP 块（必须存在 nginx 才能启动）
http {
    access_log /dev/stdout;
    error_log /dev/stderr;

    # 不需要 HTTP 服务（Flask 处理所有 HTTP）
    # 但 nginx 需要 http 块才能启动
    server {
        listen 8080;
        server_name _;
        location / { return 200 'streamlive-nginx'; }
    }
}

# RTMP 块
rtmp {
    server {
        listen 1935;
        chunk_size 4096;
        max_message 4M;

        application live {
            live on;
            record off;
            allow publish all;
            deny play all;

            # 推流鉴权回调：验证 stream key
            on_publish http://127.0.0.1:5200/api/rtmp/auth;
            on_publish_done http://127.0.0.1:5200/api/rtmp/done;

            # HLS
            hls on;
            hls_path /app/data/hls;
            hls_fragment 2s;
            hls_playlist_length 6s;
            hls_continuous on;
            hls_cleanup on;
            hls_nested on;
        }
    }
}
